# --- MinIO ---
# Пароль минимум 8 символов:  openssl rand -base64 24
MINIO_ROOT_USER=talap
MINIO_ROOT_PASSWORD=

# Порты на хосте. Меняйте, если 9000/9001 заняты другим проектом.
# Внутри контейнера всегда 9000/9001 — это только про хост.
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Хранилище ---
# Код работает с любым S3-совместимым хранилищем, меняется только endpoint.
# ВАЖНО: значения ниже — литералы, а не ссылки на MINIO_*.
# Скопируйте сюда те же логин и пароль, что задали выше.
#
# Вариант A — MinIO на сервере (docker compose up -d)
S3_ENDPOINT_URL=http://127.0.0.1:9010
S3_ACCESS_KEY_ID=talap
S3_SECRET_ACCESS_KEY=
S3_BUCKET=talap-raw
S3_REGION=us-east-1

# Вариант B — удалённый бакет (R2 / B2). Переживает потерю сервера.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto

# --- PostgreSQL (staging + core, Фаза 2) ---
# Порт хоста: 5432 на сервере занят постгресами других проектов
PG_HOST=127.0.0.1
PG_PORT=5442
PG_USER=talap
PG_PASSWORD=
PG_DATABASE=talap

# --- Резервная копия raw-слоя (rclone) ---
# MinIO живёт на диске сервера: потеря диска = потеря всей истории,
# которую нельзя собрать заново. Настройка — docs/deploy.md.
# Формат: <имя-remote-в-rclone>:<бакет>, например  r2:talap-raw-backup
# Пусто = шаг копирования просто пропускается, прогон не падает.
BACKUP_REMOTE=
# Откуда копируем. По умолчанию minio:$S3_BUCKET — менять обычно не нужно.
# BACKUP_SOURCE=minio:talap-raw

# --- hh API ---
# Формат обязателен: <ИмяПриложения>/<версия> (<ваша реальная почта>)
# hh отвечает 400 bad_user_agent, если в контакте стоит example.com
# или заголовок не похож на приложение. Проверено 2026-09-11.
HH_USER_AGENT=Talap/1.0 (<ваша-почта>)
# Приложение с dev.hh.ru. Токен получается автоматически (grant_type=client_credentials)
# и кешируется в ~/.cache/talap/hh_token.json. Redirect URI нужен только для входа
# от имени пользователя — нам он не требуется.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Альтернатива: готовый токен напрямую. Если задан — client_id/secret не используются.
HH_TOKEN=

# --- Алерты (можно оставить пустым на старте) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
