# --- Хранилище (Cloudflare R2 / Backblaze B2 / любой S3-совместимый) ---
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=talap-raw
S3_REGION=auto

# --- hh API ---
# Контакт обязателен: осмысленный User-Agent — требование ТЗ §3.3
HH_USER_AGENT=Talap/0.1 (talap-project; contact@example.com)
# Приложение с dev.hh.ru. Токен получается автоматически (grant_type=client_credentials)
# и кешируется в ~/.cache/talap/hh_token.json. Redirect URI нужен только для входа
# от имени пользователя — нам он не требуется.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Альтернатива: готовый токен напрямую. Если задан — client_id/secret не используются.
HH_TOKEN=

# --- Алерты (можно оставить пустым на старте) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
