# --- Хранилище ---
# Код работает с любым S3-совместимым хранилищем, меняется только endpoint.
#
# Вариант A — MinIO на сервере (docker-compose up -d)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=talap-raw
S3_REGION=us-east-1

# Вариант B — удалённый бакет (R2 / B2). Переживает потерю сервера.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto

# --- MinIO ---
# Логин/пароль для контейнера. Пароль минимум 8 символов, сгенерируйте:
#   openssl rand -base64 24
MINIO_ROOT_USER=talap
MINIO_ROOT_PASSWORD=

# --- Резервная копия raw-слоя (rclone) ---
# ВАЖНО: MinIO живёт на том же диске, что и сервер. Без копии наружу
# потеря диска = потеря всей истории, которую нельзя собрать заново.
# Настройка: docs/deploy.md, раздел «Резервная копия raw»
BACKUP_REMOTE=

# --- hh API ---
# Контакт обязателен: осмысленный User-Agent — требование ТЗ §3.3
HH_USER_AGENT=Talap/0.1 (talap-project; contact@example.com)
# Приложение с dev.hh.ru. Токен получается автоматически (grant_type=client_credentials)
# и кешируется в ~/.cache/talap/hh_token.json. Redirect URI нужен только для входа
# от имени пользователя — нам он не требуется.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Альтернатива: готовый токен напрямую. Если задан — client_id/secret не используются.
HH_TOKEN=

# --- Алерты (можно оставить пустым на старте) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
