# Скопировать в ~/.dbt/profiles.yml и подставить значения из .env
talap:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PG_HOST', '127.0.0.1') }}"
      port: "{{ env_var('PG_PORT', '5442') | int }}"
      user: "{{ env_var('PG_USER', 'talap') }}"
      password: "{{ env_var('PG_PASSWORD') }}"
      dbname: "{{ env_var('PG_DATABASE', 'talap') }}"
      schema: dbt
      threads: 4
